{
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "persistent-only": true,
    "sort-by": "number",
    "show-special": false,
    "all-outputs": true
  }
}
