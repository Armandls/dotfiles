{
  "battery": {
    "interval": 30,
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format": "{icon} <span size='11pt'>{capacity}%</span>",
    "format-full": "{icon} <span size='11pt'>{capacity}%</span>",
    "format-charging": "<span size='12pt'>󱐌</span> <span size='11pt'>{capacity}%</span>",
    "format-plugged": " <span size='11pt'>{capacity}%</span>",
    "format-not-charging": "󰚥 <span size='11pt'>{capacity}%</span>",
    "format-warning": "<span size='12pt'>󰂃</span> <span size='11pt'>{capacity}%</span>",
    "format-critical": "<span size='12pt'>󰀪</span> <span size='11pt'>{capacity}%</span>",
    "tooltip-format": "{timeTo}\n\n󰠠  Usage: {power:0.1f}W\n󱤅  Condition: {health}%\n",
    "format-icons": {
      "default": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    }
  }
}
